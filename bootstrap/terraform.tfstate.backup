            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"TerraformState\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:ListBucket\",\n        \"s3:GetObject\",\n        \"s3:DeleteObject\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::ecs-workshop-tfstate/*\",\n        \"arn:aws:s3:::ecs-workshop-tfstate\"\n      ]\n    },\n    {\n      \"Sid\": \"NetworkInfra\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:ReleaseAddress\",\n        \"ec2:Describe*\",\n        \"ec2:DeleteTags\",\n        \"ec2:CreateTags\",\n        \"ec2:AllocateAddress\",\n        \"ec2:*Vpc*\",\n        \"ec2:*Tags*\",\n        \"ec2:*Subnet*\",\n        \"ec2:*SecurityGroup*\",\n        \"ec2:*RouteTable*\",\n        \"ec2:*Route\",\n        \"ec2:*InternetGateway*\",\n        \"ec2:*Address*\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"ACM\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"acm:RequestCertificate\",\n        \"acm:RemoveTagsFromCertificate\",\n        \"acm:ListTagsForCertificate\",\n        \"acm:ListCertificates\",\n        \"acm:DescribeCertificate\",\n        \"acm:DeleteCertificate\",\n        \"acm:AddTagsToCertificate\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"Route53\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"route53:ListResourceRecordSets\",\n        \"route53:GetHostedZone\",\n        \"route53:GetChange\",\n        \"route53:ChangeResourceRecordSets\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"ECS\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ecs:*\",\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"ECR\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ecr:UntagResource\",\n        \"ecr:TagResource\",\n        \"ecr:PutImageScanningConfiguration\",\n        \"ecr:ListTagsForResource\",\n        \"ecr:DescribeRepositories\",\n        \"ecr:DeleteRepository\",\n        \"ecr:CreateRepository\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"ELB\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"elasticloadbalancing:*\",\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"IAM\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:UntagRole\",\n        \"iam:TagRole\",\n        \"iam:PassRole\",\n        \"iam:ListRolePolicies\",\n        \"iam:ListInstanceProfilesForRole\",\n        \"iam:ListAttachedRolePolicies\",\n        \"iam:GetRole\",\n        \"iam:DetachRolePolicy\",\n        \"iam:DeleteRole\",\n        \"iam:CreateRole\",\n        \"iam:AttachRolePolicy\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"CloudWatch\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"logs:UntagResource\",\n        \"logs:TagResource\",\n        \"logs:PutRetentionPolicy\",\n        \"logs:ListTagsForResource\",\n        \"logs:DescribeLogGroups\",\n        \"logs:DeleteLogGroup\",\n        \"logs:CreateLogGroup\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"ServiceDiscovery\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"servicediscovery:*\",\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"AutoScaling\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"application-autoscaling:*\",\n      \"Resource\": \"*\"\n    }\n  ]\n}",
